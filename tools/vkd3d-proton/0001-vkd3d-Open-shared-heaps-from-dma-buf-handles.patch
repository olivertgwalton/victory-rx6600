From 8374c877fa45539961e2fc134668ba3b8c65728c Mon Sep 17 00:00:00 2001
From: Oliver Walton <olivertgwalton03@gmail.com>
Date: Thu, 26 Nov 2026 17:31:21 +0000
Subject: [PATCH] vkd3d: Open shared heaps from dma-buf handles

OpenSharedHandle(IID_ID3D12Heap) of a handle whose file size is known
imports it as OPAQUE_WIN32 memory: a buffers-only, CPU-visible
write-back heap, as OpenExistingHeapFromAddress makes. Under Wine with
the dma-buf import in win32u (VIctory's tools/wine-dmabuf), that is the
process's own memory (a udmabuf of a section view), with no copy.
Failure is returned, not covered with an allocation of its own.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 libs/vkd3d/device.c        | 25 +++++++++++++++++++
 libs/vkd3d/heap.c          | 50 ++++++++++++++++++++++++++++++++++++--
 libs/vkd3d/memory.c        | 25 ++++++++++++++++---
 libs/vkd3d/resource.c      | 16 ++++++++++--
 libs/vkd3d/vkd3d_private.h |  8 ++++++
 5 files changed, 117 insertions(+), 7 deletions(-)

diff --git a/libs/vkd3d/device.c b/libs/vkd3d/device.c
index 6aa9234c..e9759f96 100644
--- a/libs/vkd3d/device.c
+++ b/libs/vkd3d/device.c
@@ -7015,6 +7015,31 @@ static HRESULT STDMETHODCALLTYPE d3d12_device_OpenSharedHandle(d3d12_device_ifac
         return return_interface(&fence->ID3D12Fence_iface, &IID_ID3D12Fence, riid, object);
     }
 
+    if (IsEqualGUID(riid, &IID_ID3D12Heap))
+    {
+        struct d3d12_heap *heap;
+        LARGE_INTEGER size;
+
+        /* The handles opened so far are of a dma-buf of the process's own
+         * memory, whose size is the file's (D3DKMT heap handles carry no
+         * size we can read here). */
+        if (!GetFileSizeEx(handle, &size) || size.QuadPart <= 0)
+        {
+            FIXME("Opening shared heap handles other than dma-bufs unsupported.\n");
+            *object = NULL;
+            return E_NOTIMPL;
+        }
+
+        if (FAILED(hr = d3d12_heap_create_from_handle(device, handle, size.QuadPart, &heap)))
+        {
+            WARN("Failed to open shared ID3D12Heap, hr %#x.\n", (int)hr);
+            *object = NULL;
+            return hr;
+        }
+
+        return return_interface(&heap->ID3D12Heap_iface, &IID_ID3D12Heap, riid, object);
+    }
+
     FIXME("Opening shared handle type %s unsupported\n", debugstr_guid(riid));
     return E_NOTIMPL;
 #else
diff --git a/libs/vkd3d/heap.c b/libs/vkd3d/heap.c
index 341e3e5f..d6fda706 100644
--- a/libs/vkd3d/heap.c
+++ b/libs/vkd3d/heap.c
@@ -300,7 +300,7 @@ static HRESULT validate_heap_desc(struct d3d12_device *device, const D3D12_HEAP_
 }
 
 static HRESULT d3d12_heap_init(struct d3d12_heap *heap, struct d3d12_device *device,
-        const D3D12_HEAP_DESC *desc, void* host_address)
+        const D3D12_HEAP_DESC *desc, void* host_address, const void *import)
 {
     struct vkd3d_allocate_heap_memory_info alloc_info;
     HRESULT hr;
@@ -329,6 +329,7 @@ static HRESULT d3d12_heap_init(struct d3d12_heap *heap, struct d3d12_device *dev
     memset(&alloc_info, 0, sizeof(alloc_info));
     alloc_info.heap_desc = heap->desc;
     alloc_info.host_ptr = host_address;
+    alloc_info.pNext = import;
 
     if ((alloc_info.heap_desc.Flags & D3D12_HEAP_FLAG_DENY_BUFFERS) &&
         d3d12_device_allow_image_heap_suballocation(device))
@@ -412,7 +413,7 @@ HRESULT d3d12_heap_create(struct d3d12_device *device, const D3D12_HEAP_DESC *de
     if (!(object = vkd3d_malloc(sizeof(*object))))
         return E_OUTOFMEMORY;
 
-    if (FAILED(hr = d3d12_heap_init(object, device, desc, host_address)))
+    if (FAILED(hr = d3d12_heap_init(object, device, desc, host_address, NULL)))
     {
         vkd3d_free(object);
         return hr;
@@ -423,3 +424,48 @@ HRESULT d3d12_heap_create(struct d3d12_device *device, const D3D12_HEAP_DESC *de
     *heap = object;
     return S_OK;
 }
+
+/* A heap of `size` bytes whose memory is imported from a shared handle
+ * (OPAQUE_WIN32): buffers only, CPU-visible write-back memory, as for
+ * OpenExistingHeapFromAddress. Under Wine, a handle wrapping a dma-buf of
+ * the process's own memory (a udmabuf of a section) imports it with no
+ * copy; failing that, the allocation fails rather than falling back to
+ * memory of its own, which the caller would take for the shared one. */
+HRESULT d3d12_heap_create_from_handle(struct d3d12_device *device, HANDLE handle,
+        UINT64 size, struct d3d12_heap **heap)
+{
+    VkImportMemoryWin32HandleInfoKHR import_info;
+    struct d3d12_heap *object;
+    D3D12_HEAP_DESC desc;
+    HRESULT hr;
+
+    memset(&desc, 0, sizeof(desc));
+    desc.SizeInBytes = size;
+    desc.Alignment = D3D12_DEFAULT_RESOURCE_PLACEMENT_ALIGNMENT;
+    desc.Flags = D3D12_HEAP_FLAG_SHARED | D3D12_HEAP_FLAG_ALLOW_ONLY_BUFFERS;
+    desc.Properties.Type = D3D12_HEAP_TYPE_CUSTOM;
+    desc.Properties.CPUPageProperty = D3D12_CPU_PAGE_PROPERTY_WRITE_BACK;
+    desc.Properties.MemoryPoolPreference = D3D12_MEMORY_POOL_L0;
+    desc.Properties.CreationNodeMask = 1;
+    desc.Properties.VisibleNodeMask = 1;
+
+    import_info.sType = VK_STRUCTURE_TYPE_IMPORT_MEMORY_WIN32_HANDLE_INFO_KHR;
+    import_info.pNext = NULL;
+    import_info.handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_WIN32_BIT;
+    import_info.handle = handle;
+    import_info.name = NULL;
+
+    if (!(object = vkd3d_malloc(sizeof(*object))))
+        return E_OUTOFMEMORY;
+
+    if (FAILED(hr = d3d12_heap_init(object, device, &desc, NULL, &import_info)))
+    {
+        vkd3d_free(object);
+        return hr;
+    }
+
+    TRACE("Opened heap %p of %"PRIu64" bytes from handle %p.\n", object, size, handle);
+
+    *heap = object;
+    return S_OK;
+}
diff --git a/libs/vkd3d/memory.c b/libs/vkd3d/memory.c
index 45300738..fb28533a 100644
--- a/libs/vkd3d/memory.c
+++ b/libs/vkd3d/memory.c
@@ -858,7 +858,8 @@ static HRESULT vkd3d_select_memory_flags(struct d3d12_device *device, const D3D1
     return S_OK;
 }
 
-static HRESULT vkd3d_create_global_buffer(struct d3d12_device *device, VkDeviceSize size, const D3D12_HEAP_PROPERTIES *heap_properties, D3D12_HEAP_FLAGS heap_flags, VkBuffer *vk_buffer)
+static HRESULT vkd3d_create_global_buffer(struct d3d12_device *device, VkDeviceSize size, const D3D12_HEAP_PROPERTIES *heap_properties, D3D12_HEAP_FLAGS heap_flags,
+        VkExternalMemoryHandleTypeFlags external_types, VkBuffer *vk_buffer)
 {
     D3D12_RESOURCE_DESC1 resource_desc;
 
@@ -878,7 +879,7 @@ static HRESULT vkd3d_create_global_buffer(struct d3d12_device *device, VkDeviceS
             heap_properties->Type != D3D12_HEAP_TYPE_READBACK)
         resource_desc.Flags |= D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
 
-    return vkd3d_create_buffer(device, heap_properties, heap_flags, &resource_desc, "global-buffer", vk_buffer);
+    return vkd3d_create_buffer_external(device, heap_properties, heap_flags, &resource_desc, "global-buffer", external_types, vk_buffer);
 }
 
 static void vkd3d_report_memory_budget(struct d3d12_device *device)
@@ -1386,6 +1387,22 @@ static bool vkd3d_is_imported_allocation(const struct vkd3d_allocate_memory_info
     return false;
 }
 
+/* The handle type of the memory an allocation imports by handle, or 0: a
+ * buffer bound to such memory must declare it. */
+static VkExternalMemoryHandleTypeFlags vkd3d_imported_handle_types(const struct vkd3d_allocate_memory_info *info)
+{
+    const VkBaseInStructure *next = info->pNext;
+
+    while (next)
+    {
+        if (next->sType == VK_STRUCTURE_TYPE_IMPORT_MEMORY_WIN32_HANDLE_INFO_KHR)
+            return ((const VkImportMemoryWin32HandleInfoKHR *)next)->handleType;
+        next = next->pNext;
+    }
+
+    return 0;
+}
+
 static bool d3d12_device_aligns_bda_64k(struct d3d12_device *device)
 {
     /* Only seems to affect Turnip for now at least.
@@ -1488,7 +1505,8 @@ static HRESULT vkd3d_memory_allocation_init(struct vkd3d_memory_allocation *allo
              * and derive the exact memory requirements from that. Any buffer
              * resources are just going to use this buffer with an offset. */
             if (FAILED(hr = vkd3d_create_global_buffer(device, padded_memory_requirement_size,
-                    &info->heap_properties, info->heap_flags, &allocation->resource.vk_buffer)))
+                    &info->heap_properties, info->heap_flags,
+                    vkd3d_imported_handle_types(info), &allocation->resource.vk_buffer)))
                 return hr;
         }
 
@@ -2335,6 +2353,7 @@ HRESULT vkd3d_allocate_heap_memory(struct d3d12_device *device, struct vkd3d_mem
     alloc_info.heap_properties = info->heap_desc.Properties;
     alloc_info.heap_flags = info->heap_desc.Flags;
     alloc_info.host_ptr = info->host_ptr;
+    alloc_info.pNext = info->pNext;
     alloc_info.vk_memory_priority = info->vk_memory_priority;
     alloc_info.explicit_global_buffer_usage = info->explicit_global_buffer_usage;
 
diff --git a/libs/vkd3d/resource.c b/libs/vkd3d/resource.c
index 39e4b0b6..91c4db19 100644
--- a/libs/vkd3d/resource.c
+++ b/libs/vkd3d/resource.c
@@ -169,6 +169,15 @@ static inline VkDeviceSize adjust_sparse_buffer_size(VkDeviceSize size)
 HRESULT vkd3d_create_buffer(struct d3d12_device *device,
         const D3D12_HEAP_PROPERTIES *heap_properties, D3D12_HEAP_FLAGS heap_flags,
         const D3D12_RESOURCE_DESC1 *desc, const char *tag, VkBuffer *vk_buffer)
+{
+    return vkd3d_create_buffer_external(device, heap_properties, heap_flags, desc, tag, 0, vk_buffer);
+}
+
+/* vkd3d_create_buffer() for memory of external_types (imported), if not 0. */
+HRESULT vkd3d_create_buffer_external(struct d3d12_device *device,
+        const D3D12_HEAP_PROPERTIES *heap_properties, D3D12_HEAP_FLAGS heap_flags,
+        const D3D12_RESOURCE_DESC1 *desc, const char *tag,
+        VkExternalMemoryHandleTypeFlags external_types, VkBuffer *vk_buffer)
 {
     const struct vkd3d_vk_device_procs *vk_procs = &device->vk_procs;
     VkBufferDeviceAddressAlignmentAllocateInfoVALVE alignment_info;
@@ -187,11 +196,14 @@ HRESULT vkd3d_create_buffer(struct d3d12_device *device,
 
     /* This is only used by OpenExistingHeapFrom*,
      * and external host memory is the only way for us to do CROSS_ADAPTER. */
-    if (desc->Flags & D3D12_RESOURCE_FLAG_ALLOW_CROSS_ADAPTER)
+    if (!external_types && (desc->Flags & D3D12_RESOURCE_FLAG_ALLOW_CROSS_ADAPTER))
+        external_types = VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT;
+
+    if (external_types)
     {
         external_info.sType = VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_BUFFER_CREATE_INFO;
         external_info.pNext = NULL;
-        external_info.handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT;
+        external_info.handleTypes = external_types;
         vk_prepend_struct(&buffer_info, &external_info);
     }
 
diff --git a/libs/vkd3d/vkd3d_private.h b/libs/vkd3d/vkd3d_private.h
index e63dc7b7..f0580753 100644
--- a/libs/vkd3d/vkd3d_private.h
+++ b/libs/vkd3d/vkd3d_private.h
@@ -822,6 +822,8 @@ struct vkd3d_allocate_heap_memory_info
 {
     D3D12_HEAP_DESC heap_desc;
     void *host_ptr;
+    /* An import (VkImportMemoryWin32HandleInfoKHR), or NULL. */
+    const void *pNext;
     uint32_t extra_allocation_flags;
     float vk_memory_priority;
     VkBufferUsageFlags2KHR explicit_global_buffer_usage;
@@ -1064,6 +1066,8 @@ struct d3d12_heap
 
 HRESULT d3d12_heap_create(struct d3d12_device *device, const D3D12_HEAP_DESC *desc,
         void *host_address, struct d3d12_heap **heap);
+HRESULT d3d12_heap_create_from_handle(struct d3d12_device *device, HANDLE handle,
+        UINT64 size, struct d3d12_heap **heap);
 HRESULT d3d12_device_validate_custom_heap_type(struct d3d12_device *device,
         const D3D12_HEAP_PROPERTIES *heap_properties);
 
@@ -1317,6 +1321,10 @@ void vkd3d_free_device_memory(struct d3d12_device *device,
 HRESULT vkd3d_allocate_internal_buffer_memory(struct d3d12_device *device, VkBuffer vk_buffer,
         VkMemoryPropertyFlags type_flags, VkMemoryAllocateFlags allocate_flags,
         struct vkd3d_device_memory_allocation *allocation);
+HRESULT vkd3d_create_buffer_external(struct d3d12_device *device,
+        const D3D12_HEAP_PROPERTIES *heap_properties, D3D12_HEAP_FLAGS heap_flags,
+        const D3D12_RESOURCE_DESC1 *desc, const char *tag,
+        VkExternalMemoryHandleTypeFlags external_types, VkBuffer *vk_buffer);
 HRESULT vkd3d_create_buffer(struct d3d12_device *device,
         const D3D12_HEAP_PROPERTIES *heap_properties, D3D12_HEAP_FLAGS heap_flags,
         const D3D12_RESOURCE_DESC1 *desc, const char *tag, VkBuffer *vk_buffer);
